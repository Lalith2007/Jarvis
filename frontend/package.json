{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "node electron/dev.cjs",
    "desktop:prod": "npm run build && electron .",
    "desktop:package": "npm run native:prepare && npm run build && electron-builder --mac",
    "native:prepare": "node electron/macos/build-wake-listener.cjs",
    "native:package": "npm run native:prepare && npm run build && electron-builder --mac dir",
    "native:install": "node electron/macos/install-launch-agent.cjs",
    "native:uninstall": "node electron/macos/uninstall-launch-agent.cjs",
    "native:status": "node electron/macos/status-launch-agent.cjs",
    "native:wake-test": "node electron/macos/run-wake-listener.cjs",
    "build": "tsc -b && vite build && sed -i '' 's/crossorigin//g' dist/index.html",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "node scripts/deploy.cjs",
    "test:regression": "node scripts/regression-check.cjs"
  },
  "build": {
    "appId": "ai.jarvis",
    "productName": "J.A.R.V.I.S",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleName": "J.A.R.V.I.S",
        "CFBundleDisplayName": "J.A.R.V.I.S",
        "NSMicrophoneUsageDescription": "J.A.R.V.I.S listens for the wake phrase Hey Jarvis.",
        "NSSpeechRecognitionUsageDescription": "J.A.R.V.I.S uses speech recognition to detect the wake phrase Hey Jarvis."
      },
      "extraFiles": [
        {
          "from": "electron/macos/bin/jarvis-wake-listener",
          "to": "MacOS/jarvis-wake-listener"
        }
      ],
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  }
}
