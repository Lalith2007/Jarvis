import pytest
from fastapi.testclient import TestClient
from main import app
from app.platform.event_bus import event_bus
from app.platform.models import PlatformEvent
import time
import json

@pytest.fixture
def client():
    # TestClient in newer versions supports .websocket_connect
    with TestClient(app) as c:
        yield c

def test_platform_websocket(client: TestClient):
    # Connect to the WebSocket
    with client.websocket_connect("/ws/platform") as websocket:
        
        # Emit a PlatformEvent
        test_event = PlatformEvent(
            subsystem="test",
            event_type="test-event",
            payload={"message": "hello world"}
        )
        event_bus.publish(test_event)
        
        # Receive the event via the websocket
        data = websocket.receive_text()
        parsed = json.loads(data)
        
        assert parsed["event_type"] == "test-event"
        assert parsed["payload"]["message"] == "hello world"
